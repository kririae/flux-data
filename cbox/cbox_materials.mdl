mdl 1.7;

import ::df::*;

export material GreyMaterial() = material(
    surface: material_surface(
        scattering: df::diffuse_reflection_bsdf(
            tint: color(0.725, 0.71, 0.68)
        )
    )
);

export material RedMaterial() = material(
    surface: material_surface(
        scattering: df::diffuse_reflection_bsdf(
            tint: color(0.63, 0.065, 0.05)
        )
    )
);

export material GreenMaterial() = material(
    surface: material_surface(
        scattering: df::diffuse_reflection_bsdf(
            tint: color(0.14, 0.45, 0.091)
        )
    )
);
