def Xform "World" {
    def Camera "Camera" {
        float focalLength = 50.0
        float horizontalAperture = 17.183143
        float verticalAperture = 17.183143
        double3 xformOp:translate = (0, 1, 6.8)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def RectLight "CeilingLight" {
        float inputs:width = 0.5
        float inputs:height = 0.5
        color3f inputs:color = (1.0, 1.0, 1.0)
        float inputs:intensity = 17.0
        float inputs:exposure = 0.0
        double3 xformOp:translate = (0, 1.98, 0)
        double3 xformOp:rotateXYZ = (-90, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    def Material "GreyMat" {
        token outputs:surface.connect = </World/GreyMat/PBR.outputs:surface>

        def Shader "PBR" {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.725, 0.71, 0.68)
            float inputs:roughness = 1.0
            float inputs:metallic = 0.0
            token outputs:surface
        }
    }

    def Material "RedMat" {
